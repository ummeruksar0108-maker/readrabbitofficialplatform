{
  "entities": {
    "courses": {
      "title": "Courses Data",
      "description": "Stores the complete course curriculum structure and study materials for Read Rabbit",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "coursesData": { "type": "array" },
        "updatedAt": { "type": "string" }
      },
      "required": ["coursesData"]
    },
    "uploaded_files": {
      "title": "Uploaded Files",
      "description": "Stores metadata and shared cloud URLs of uploaded study materials across devices",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "size": { "type": "string" },
        "type": { "type": "string" },
        "url": { "type": "string" },
        "dataUrl": { "type": "string" },
        "subjectId": { "type": "string" },
        "unitId": { "type": "string" },
        "uploadedAt": { "type": "string" }
      },
      "required": ["name"]
    },
    "student_visitors": {
      "title": "Student Visitors",
      "description": "Stores registered student profiles and activity records across web sessions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "courseId": { "type": "string" },
        "courseName": { "type": "string" },
        "lastActive": { "type": "string" },
        "lastActiveTimestamp": { "type": "number" },
        "visitCount": { "type": "number" }
      },
      "required": ["name", "email"]
    },
    "notifications": {
      "title": "Notifications",
      "description": "Stores application notifications and announcements",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "notifications": { "type": "array" },
        "updatedAt": { "type": "string" }
      },
      "required": ["notifications"]
    },
    "feedback": {
      "title": "Student Feedback",
      "description": "Stores student feedback and suggestions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "feedback": { "type": "array" },
        "updatedAt": { "type": "string" }
      },
      "required": ["feedback"]
    },
    "test": {
      "title": "Test Connection",
      "description": "Used to validate connection to Firestore backend",
      "type": "object",
      "properties": {
        "id": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/courses/{courseId}": {
      "schema": "courses",
      "description": "Stores core curriculum documents"
    },
    "/uploaded_files/{fileId}": {
      "schema": "uploaded_files",
      "description": "Stores uploaded file metadata and binary content"
    },
    "/student_visitors/{visitorId}": {
      "schema": "student_visitors",
      "description": "Stores student user profile and access directory documents"
    },
    "/notifications/{notificationId}": {
      "schema": "notifications",
      "description": "Stores broadcast notifications"
    },
    "/feedback/{feedbackId}": {
      "schema": "feedback",
      "description": "Stores student feedback records"
    },
    "/test/{testId}": {
      "schema": "test",
      "description": "Test connection endpoint"
    }
  }
}
